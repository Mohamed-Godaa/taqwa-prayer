{
  "name": "taqwa-prayer",
  "version": "1.0.0",
  "description": "Taqwa Prayer — Windows desktop widget for Islamic prayer times",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "web": "npx serve . -l 3000",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist-win": "electron-builder --win nsis"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.taqwa.prayer",
    "productName": "Taqwa Prayer",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "cities.js",
      "i18n.js",
      "app.js",
      "package.json",
      "build/icon.ico",
      "build/icon.png"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Taqwa Prayer"
    }
  }
}
